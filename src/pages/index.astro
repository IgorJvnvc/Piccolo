---
import { buildHomePage } from '@/composition/home';
import { container } from '@/composition/container';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { About } from '@/sections/about';
import { Dock } from '@/sections/dock';
import { Follow } from '@/sections/follow';
import { Footer } from '@/sections/footer';
import { Hero } from '@/sections/hero';
import { Intro } from '@/sections/intro';
import { Menu } from '@/sections/menu';
import { Navbar } from '@/sections/navbar';
import { Popular } from '@/sections/popular';
import { ToTop } from '@/sections/to-top';
import { Visit } from '@/sections/visit';
import { env } from '@/shared/config';

const page = await buildHomePage(container, env.siteUrl);
---

<BaseLayout {...page.seo}>
  <Intro slot="header" {...page.intro} />
  <Navbar slot="header" {...page.navbar} />
  <Hero {...page.hero} />
  <About {...page.about} />
  <Popular {...page.popular} />
  <Menu {...page.menu} />
  <Follow {...page.follow} />
  <Visit {...page.visit} />
  <Footer slot="footer" {...page.footer} />
  <Dock slot="footer" {...page.dock} />
  <ToTop slot="footer" {...page.toTop} />
</BaseLayout>

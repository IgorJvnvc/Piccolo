---
import { MenuBrowser } from '@/features/menu-browser';
import { enhanceAttr, partAttr } from '@/shared/lib';
import { Container, SectionHeading } from '@/shared/ui';
import { MENU } from './menu.hooks';
import styles from './menu.module.css';
import type { MenuSectionProps } from './types';

type Props = MenuSectionProps;

const { title, intro, categories, phone } = Astro.props;
---

<section id="menu" class={styles.root} aria-labelledby="menu-title" {...enhanceAttr(MENU.name)}>
  <Container>
    <div class={styles.head} data-reveal="up" {...partAttr(MENU.parts.head)}>
      <SectionHeading id="menu-title" title={title} />
      <p class={styles.intro}>{intro}</p>
    </div>
    <div class={styles.browser} data-reveal="up" {...partAttr(MENU.parts.browser)}>
      <MenuBrowser client:idle categories={categories} phone={phone} />
    </div>
  </Container>
</section>

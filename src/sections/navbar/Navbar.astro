---
import { MobileNav } from '@/features/mobile-nav';
import { enhanceAttr, partAttr } from '@/shared/lib';
import { Container, Icon, Logo, OpenStatus } from '@/shared/ui';
import { NAVBAR } from './navbar.hooks';
import styles from './navbar.module.css';
import type { NavbarProps } from './types';

type Props = NavbarProps;

const { brand, homeHref = '#top', links, phone, callLabel, hours, openLabel, socials } = Astro.props;
---

<header class={styles.root} {...enhanceAttr(NAVBAR.name)}>
  <Container class={styles.inner}>
    <nav class={styles.nav} aria-label="Primary">
      <ul class={styles.list}>
        {
          links.map((link) => (
            <li>
              <a class={styles.link} href={link.href} {...partAttr('link')}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Logo class={styles.logo} name={brand.name} tagline={brand.tagline} href={homeHref} />

    <div class={styles.actions}>
      <OpenStatus class={styles.status} hours={hours} label={openLabel} />
      <a class={styles.call} href={phone.href} aria-label={`${callLabel}: ${phone.display}`}>
        <Icon name="phone" class={styles.callIcon} />
        <span class={styles.callText}>{phone.display}</span>
      </a>
      <MobileNav client:media="(max-width: 1023px)" brand={brand} links={links} phone={phone} socials={socials} />
    </div>
  </Container>
</header>
